      "source": [
        "import os\n",
        "from google.colab import userdata\n",
        "os.environ['OPENAI_API_KEY'] = userdata.get('GROQ_API_KEY')\n",
        "os.environ['OPENAI_BASE_URL'] = 'https://api.groq.com/openai/v1'\n",
        "\n",
        "!python -m twbench.run --backend openai --model openai/gpt-oss-120b --name gpt-oss-120b \\\n",
        "    --conditions baseline,skill --reasoning-effort low --max-tokens 3000 --rpm 4 \\\n",
        "    --price-in 0.15 --price-out 0.60 --out \"$OUT\""
      ]
    },
